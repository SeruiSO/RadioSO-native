<?xml version="1.0" encoding="utf-8"?>
<!--
  Radio streams often use plain HTTP. Cleartext is allowed via explicit config
  instead of android:usesCleartextTraffic on <application>.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
